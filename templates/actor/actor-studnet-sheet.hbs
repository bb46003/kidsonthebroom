<section class="main tab equipment {{tabs.main.cssClass}}"
  data-tab="main"
  action-data="tab"
  data-group="items" >
  <main class="student-layout">
    <section class="student-main">
      <section class="sheet-panel identity-panel">
        <h2>{{localize "kotb.studentInformation"}}</h2>
        <div class="field-row">
          <div>
            <label>{{localize "kotb.age"}}</label>
            {{formInput systemFields.age value=system.age}}
          </div>

          <div>
            <label>{{localize "kotb.pronouns"}}</label>
            {{formInput systemFields.pronouns value=system.pronouns}}
          </div>
          <div>
            <label>{{localize "kotb.grade"}}</label>
            {{formInput systemFields.grade value=system.grade}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize systemFields.fear.label}}</label>
          {{formInput
            fear.field
            value=fear.value
            enriched=fear.enriched
            toggled="true"
          }}
        </div>
        <div class="field-group">
          <label>{{localize systemFields.motivation.label}}</label>
          {{formInput
            motivation.field
            value=motivation.value
            enriched=motivation.enriched
            toggled="true"
          }}
        </div>

      </section>
      <section class="sheet-panel equipment-panel">
        <div class="equipment-section">
          <h3>{{localize "kotb.broom"}}</h3>

          {{#each itemsByType.broom}}
            <div class="item-entry" data-item-id="{{this.id}}">
              <img src="{{this.img}}" alt="{{this.name}}" />
              <span>{{this.name}}</span>
            </div>
          {{else}}
            <p>{{localize "kotb.noBroom"}}</p>
          {{/each}}
        </div>
        <div class="equipment-section">
          <h3>{{localize "kotb.wand"}}</h3>
          {{#each itemsByType.wand}}
            <div class="item-entry" data-item-id="{{this.id}}">
              <img src="{{this.img}}" alt="{{this.name}}" />
              <span>{{this.name}}</span>
            </div>
          {{else}}
            <p>{{localize "kotb.noWand"}}</p>
          {{/each}}
        </div>
        <div class="equipment-section">
          <h3>{{localize systemFields.animalfamiliar.label}}</h3>
          <div class="familiar-entry">
            <div class="flexcol">
                            <label>{{localize
                  systemFields.animalfamiliar.fields.img.label
                }}</label>
                                <img
      class="item-img"
      src="{{system.animalfamiliar.img}}"
      data-action="editImage"
      data-edit="system.animalfamiliar.img"
    />
            </div>
            <div class="flexcol">
              <label>{{localize
                  systemFields.animalfamiliar.fields.name.label
                }}</label>
              <span>{{formInput
                  systemFields.animalfamiliar.fields.name
                  value=system.animalfamiliar.name
                }}</span>
            </div>
            <div class="flexcol">
              <label>{{localize
                  systemFields.animalfamiliar.fields.spiecies.label
                }}</label>
              <span>{{formInput
                  systemFields.animalfamiliar.fields.spiecies
                  value=system.animalfamiliar.spiecies
                }}</span>
            </div>
          </div>
        </div>
      </section>
      <section class="sheet-panel strengths-panel">
        <h2>{{localize "kotb.strengths"}}</h2>
        {{#each items.strengths as |strength key|}}
        <div class="flexrow actor-item">
          <img class="item-img" src="{{strength.img}}">
          <a class="use-item" data-action="useItem" data-id="{{key}}" title="{{localize "kotb.useItem"}}">{{strength.name}}</a>
          <a class="threeDots" data-action="itemContextMenu" data-item="{{key}}">
             <i class="fas fa-ellipsis-v"></i>
          </a>
        </div>
        {{else}}
          <p>{{localize "kotb.noStrengths"}}</p>
        {{/each}}
      </section>
    </section>
    <aside class="student-sidebar">
      <section class="sheet-panel attributes-panel">
        <h2>{{localize "kotb.attributes.label"}}</h2>
        <div class="attributes-grid">
          {{#each @root.systemFields.attributes as |attribute key|}}
            <div class="attribute-card">
              <label>{{localize attribute.label}}</label>

              <div class="attribute-dice">
                <label>{{localize attribute.fields.dice.label}}</label>
                {{formInput
                  attribute.fields.dice
                  value=(lookup
                    (lookup @root.system.attributes attribute.name) "dice"
                  )
                }}
              </div>
              {{log
                (lookup (lookup @root.system.attributes attribute.name) "dice")
              }}
              <div class="attribute-values">

                <div class="attribute-value">
                  <a><label>{{localize attribute.fields.stat.label}}</label></a>
                  <strong>
                    {{lookup
                      (lookup
                        (lookup @root.system.attributes attribute.name) "stat"
                      )
                      "total"
                    }}
                  </strong>
                  <label>{{localize
                      attribute.fields.stat.fields.total.label
                    }}</label>

                  {{formInput
                    attribute.fields.stat.fields.value
                    value=(lookup
                      (lookup
                        (lookup @root.system.attributes attribute.name) "stat"
                      )
                      "value"
                    )
                  }}
                </div>

                <div class="attribute-value">
                  <a><label>{{localize
                        attribute.fields.magic.label
                      }}</label></a>
                  <strong>
                    {{lookup
                      (lookup
                        (lookup @root.system.attributes attribute.name) "magic"
                      )
                      "total"
                    }}
                  </strong>
                  <label>{{localize
                      attribute.fields.magic.fields.total.label
                    }}</label>
                  {{formInput
                    attribute.fields.magic.fields.value
                    value=(lookup
                      (lookup
                        (lookup @root.system.attributes attribute.name) "magic"
                      )
                      "value"
                    )
                  }}
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      </section>

      <section class="sheet-panel trope-panel">
        <h2>{{localize systemFields.tropequestions.label}}</h2>
        {{formInput
          tropequestions.field
          value=tropequestions.value
          enriched=tropequestions.enriched
          toggled="true"
        }}
      </section>
    </aside>
  </main>
</section>