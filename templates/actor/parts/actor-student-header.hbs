<section class="sheet-header">
  <div class="image-container">
    {{#if (not tokenDisplay)}}
    <img
      class="profile-img"
      src="{{@root.actor.img}}"
      data-edit="img"
      data-action="editImage"
      data-edit="img"
    />
    {{else}}
    <img
      class="profile-img"
      src="{{@root.tokenImg}}"
      data-action="editImage"
      data-edit="prototypeToken.texture.src"
    />
    {{/if}}
      <div class="toggle-wrapper">
  <span class="label">{{localize "kotb.art"}}</span>
  <label class="switch">
    <input type="checkbox" data-action="toggle" {{#if tokenDisplay}}checked{{/if}}>
    <span class="slider"></span>
  </label>

  <span class="label">{{localize "kotb.token"}}</span>
</div>
  </div>
  <div class="identity">
    <h2>{{localize "kotb.name"}}</h2>
    <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize "kotb.namePlaceholder"}}" />
</div>


        <div class="adversity-panel">
        <h2>{{localize systemFields.asversityTokens.label}}</h2>
        <div class="flexrow">
          <label>{{localize "kotb.asversityTokens.description"}}</label>
          {{formInput
            systemFields.asversityTokens
            value=system.asversityTokens
          }}
        </div>
      </div>
</section>