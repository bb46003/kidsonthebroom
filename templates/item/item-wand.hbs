
<div class="wand-sheet">
    <header class="talent-header flexrow">
      <div class="image-container">
        <img
          class="profile-img"
          src="{{item.img}}"
          data-edit="img"
          data-action="editImage"
          data-edit="img"
        />
      </div>
      <h3>{{localize "kotb.wandName"}}
        <input
          name="name"
          type="text"
          value="{{item.name}}"
          placeholder="Name"
        />
      </h3>

    </header>
    <div class="form-group">
        <label>{{systemFields.core.label}}</label>
        {{formInput systemFields.core.fields.name value=system.core.name}}
        <label>{{localize systemFields.core.fields.skill.label }}</label>
        {{formInput systemFields.core.fields.skill value=system.core.skill}}
    </div>
    <div class="form-group">
        <label>{{systemFields.wood.label}}</label>
        {{formInput systemFields.wood.fields.name value=system.wood.name}}
        <label>{{localize systemFields.wood.fields.skill.label }}</label>
        {{formInput systemFields.wood.fields.skill value=system.wood.skill}}
    </div>
    <div class="field-group">
        <label>{{localize systemFields.description.label}}</label>
        {{formInput
            description.field
            value=description.value
            enriched=description.enriched
            toggled="true"
        }}
    </div>
</div>